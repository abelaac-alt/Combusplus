<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_full_tank_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_full_tank_modern_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/widget_dark_logo_background"
        android:contentDescription="@string/app_name"
        android:padding="7dp"
        android:src="@drawable/logo_combusplus" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEPÓSITO LLENO"
            android:textColor="#FFFFC6CA"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Encuentra la mejor gasolinera"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Precio, distancia y coste real"
            android:textColor="#FFC7CBD3"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_full_tank_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_round_action_background"
        android:gravity="center"
        android:text="→"
        android:textColor="#FFB3131B"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
