<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_favorites_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_favorites_modern_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/widget_favorites_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_logo_background"
            android:contentDescription="@string/app_name"
            android:padding="6dp"
            android:src="@drawable/logo_combusplus" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GASOLINERAS FAVORITAS"
                android:textColor="#FFB3131B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precios actuales"
                android:textColor="#FF15171A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_favorites_refresh"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/widget_refresh_background"
            android:gravity="center"
            android:minWidth="92dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="↻ Actualizar"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_favorites_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Precios pendientes de actualizar"
        android:textColor="#FF747982"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_favorites_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Guarda gasolineras como favoritas para consultar sus precios aquí."
        android:textColor="#FF686D75"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/favorite_row_1"
        style="@style/WidgetFavoriteRow">
        <LinearLayout style="@style/WidgetFavoriteTextColumn">
            <TextView android:id="@+id/favorite_name_1" style="@style/WidgetFavoriteName" />
            <TextView android:id="@+id/favorite_change_1" style="@style/WidgetFavoriteChange" />
        </LinearLayout>
        <TextView android:id="@+id/favorite_price_1" style="@style/WidgetFavoritePrice" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/favorite_row_2"
        style="@style/WidgetFavoriteRow">
        <LinearLayout style="@style/WidgetFavoriteTextColumn">
            <TextView android:id="@+id/favorite_name_2" style="@style/WidgetFavoriteName" />
            <TextView android:id="@+id/favorite_change_2" style="@style/WidgetFavoriteChange" />
        </LinearLayout>
        <TextView android:id="@+id/favorite_price_2" style="@style/WidgetFavoritePrice" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/favorite_row_3"
        style="@style/WidgetFavoriteRow">
        <LinearLayout style="@style/WidgetFavoriteTextColumn">
            <TextView android:id="@+id/favorite_name_3" style="@style/WidgetFavoriteName" />
            <TextView android:id="@+id/favorite_change_3" style="@style/WidgetFavoriteChange" />
        </LinearLayout>
        <TextView android:id="@+id/favorite_price_3" style="@style/WidgetFavoritePrice" />
    </LinearLayout>
</LinearLayout>
